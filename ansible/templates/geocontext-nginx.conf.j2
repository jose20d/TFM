# GeoContext production HTTP reverse proxy.
# Este archivo se usa como configuración base previa a habilitar TLS.
{% set all_domains = [geocontext_domain | default('_')] + (geocontext_alt_domains | default([])) %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ all_domains | join(' ') }};

    # Necesario para completar desafíos ACME de Let's Encrypt por webroot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    # Frontend Next.js en contenedor local puerto 3000.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Endpoints internos de admin viven en Next.js (API routes frontend).
    # Deben evaluarse antes del bloque /api/ para no enviarlos al backend FastAPI.
    location /api/internal-admin/ {
        proxy_pass http://127.0.0.1:3000/api/internal-admin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend FastAPI bajo prefijo /api.
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
